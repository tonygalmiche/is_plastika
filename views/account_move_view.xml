<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_in_invoice_bill_tree_inherit" model="ir.ui.view">
            <field name="name">view_in_invoice_bill_tree_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="is_societe_comptable"/>
                    <field name="is_date_declaration" optional="hide"/>
                    <field name="is_taux_change_tnd"  optional="hide"/>
                </field>
            </field>
        </record>
        <record id="view_out_invoice_tree_inherit" model="ir.ui.view">
            <field name="name">view_out_invoice_tree_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="is_societe_comptable"/>
                    <field name="is_devise_tunisienne_id" optional="show"/>
                    <field name="is_date_declaration" optional="show"/>
                    <field name="is_taux_change_tnd" optional="show"/>
                    <field name="is_total_mp" optional="show"/>
                    <field name="is_total_amt" optional="show"/>
                    <field name="is_total_service" optional="show"/>
                </field>
            </field>
        </record>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">view_move_form_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_view_related_pickings" type="object" class="oe_stat_button" icon="fa-truck">
                        <field name="is_picking_count" widget="statinfo" string="Livraisons"/>
                    </button>
                </xpath>
                <field name="partner_id" position="after">
                    <field name="is_societe_comptable"/>
                    <field name="is_facture_refacturation_id" attrs="{'invisible': [('is_facture_refacturation_id', '=', False)]}"/>
                    <field name="is_factures_refacturees_ids" widget="many2many_tags" attrs="{'invisible': [('is_factures_refacturees_ids', '=', [])]}"/>
                </field>
                <field name="invoice_date" position="after">
                    <field name="is_date_declaration_vsb" invisible="1"/>
                    <field name="is_date_declaration" attrs="{'invisible': [('is_date_declaration_vsb', '=', False)]}"/>
                    <field name="is_taux_change_tnd"  attrs="{'invisible': [('is_date_declaration_vsb', '=', False)]}" readonly="1" force_save="1"/>
                </field>
                <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="after">
                    <field name="is_pu_mp"  optional="show" readonly="1" force_save="1"/>
                    <field name="is_pu_amt" optional="show" readonly="1" force_save="1"/>
                    <field name="is_pu_pf"  optional="show" readonly="1" force_save="1"/>
                    <field name="is_ligne_facture_fournisseur_id" optional="hide" force_save="1"/>
                </xpath>
                <page name="other_info" position="inside">
                    <group string="Plasti-ka">
                        <field name="is_devise_tunisienne_id"/>
                        <field name="is_total_mp" readonly="1"/>
                        <field name="is_total_amt" readonly="1"/>
                        <field name="is_total_service" readonly="1"/>
                        <field name="is_nb_pieces" readonly="1"/>
                        <field name="is_nb_colis" readonly="1"/>
                        <field name="is_nb_palettes" readonly="1"/>
                    </group>
                </page>
            </field>
        </record>
        <!-- Refacturation à Gray des factures fournisseur PK -->
        <record id="is_factures_a_refacturer_gray_tree" model="ir.ui.view">
            <field name="name">is_factures_a_refacturer_gray_tree</field>
            <field name="model">account.move</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <header>
                        <button name="refacturer_gray_action" type="object" string="Refacturer à Gray" class="btn-primary"/>
                    </header>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="supplier_invoice_number"/>
                    <field name="invoice_date"/>
                    <field name="currency_id"/>
                    <field name="amount_untaxed" string="Montant HT"/>
                    <field name="amount_total"   string="Total"/>
                    <field name="state" invisible="1"/>
                </tree>
            </field>
        </record>
        <record id="is_factures_a_refacturer_gray_action" model="ir.actions.act_window">
            <field name="name">Factures à refacturer à Gray</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="is_factures_a_refacturer_gray_tree"/>
            <field name="domain">[('is_a_refacturer', '=', True)]</field>
            <field name="context">{'default_move_type': 'in_invoice'}</field>
        </record>
        <record id="view_account_invoice_filter_inherit" model="ir.ui.view">
            <field name="name">view_account_invoice_filter_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="is_societe_comptable"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
