<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Liens entre la commande Gray et la commande PK générée à sa validation -->
        <record id="is_plastika_purchase_order_form" model="ir.ui.view">
            <field name="name">is_plastika_purchase_order_form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="is_plastigray16.is_purchase_order_form" />
            <field name="arch" type="xml">
                <field name="is_modified" position="after">
                    <field name="is_commande_pk_id"   attrs="{'invisible': [('is_commande_pk_id', '=', False)]}"/>
                    <field name="is_commande_gray_id" attrs="{'invisible': [('is_commande_gray_id', '=', False)]}"/>
                </field>
                <xpath expr="//page[@name='products']/field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                    <field name="is_ligne_pk_id"   optional="hide"/>
                    <field name="is_ligne_gray_id" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
