<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="is_plastika_view_company_form" model="ir.ui.view">
            <field name="name">is_plastika_view_company_form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="is_plastigray16.is_view_company_form" />
            <field name="arch" type="xml">
                <field name="is_taux_devise_dinar" position="attributes">
                    <attribute name="readonly">1</attribute>
                </field>
                <field name="is_taux_commission" position="attributes">
                    <attribute name="readonly">1</attribute>
                </field>
                <field name="is_taux_commission" position="after">
                    <field name="is_taux_facturation_pk_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                            <field name="date_debut"/>
                            <field name="taux_devise_dinar"/>
                            <field name="taux_commission"/>
                        </tree>
                    </field>
                    <field name="is_maj_listes_gray_vsb" invisible="1"/>
                    <button
                        attrs="{'invisible': [('is_maj_listes_gray_vsb', '=', False)]}"
                        name="maj_listes_prix_gray_action" type="object"
                        string="Mise à jour des listes de prix Gray" class="btn-outline-primary" colspan="2"
                        confirm="Recréer les versions en cours et futures de toutes les listes de prix Gray depuis les listes TND des fournisseurs de PK ?"
                    />
                </field>
            </field>
        </record>
    </data>
</odoo>
