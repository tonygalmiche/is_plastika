<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="is_vpicktree_inherit" model="ir.ui.view">
            <field name="name">is_vpicktree_inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="is_plastigray16.is_vpicktree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="is_societe_comptable"/>
                </field>
            </field>
        </record>
        <record id="is_view_picking_form_inherit" model="ir.ui.view">
            <field name="name">is_view_picking_form_inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="is_plastigray16.is_view_picking_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="is_societe_comptable"/>
                    <field name="is_reception_gray_id" attrs="{'invisible': [('is_reception_gray_id', '=', False)]}"/>
                    <field name="is_reception_pk_id"   attrs="{'invisible': [('is_reception_pk_id', '=', False)]}"/>
                </field>
                <!-- Réception PK reliée : validée ou annulée uniquement par la réception Gray -->
                <xpath expr="//header" position="inside">
                    <field name="is_reception_pk_liee" invisible="1"/>
                </xpath>
                <button name="action_annuler_reception" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', ('purchase_id', '=', False), ('state', '!=', 'done'), ('is_reception_gray_id', '!=', False)]}</attribute>
                </button>
                <xpath expr="//header/button[@name='%(is_plastigray16.stock_transfer_details_action)d']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', ('state', 'not in', ['assigned','confirmed','waiting']), ('picking_type_id','!=',1), ('is_reception_pk_liee', '=', True)]}</attribute>
                </xpath>
                <button name="action_cancel" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ('assigned', 'confirmed', 'draft', 'waiting')), ('is_reception_pk_liee', '=', True)]}</attribute>
                </button>
            </field>
        </record>
        <record id="view_picking_internal_search_inherit" model="ir.ui.view">
            <field name="name">view_picking_internal_search_inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="is_societe_comptable"/>
                </field>
            </field>
        </record>
        <record id="is_plastigray16.is_livraisons_a_facturer_action" model="ir.actions.act_window">
            <field name="domain">[
                    ('picking_type_id','=', 2),
                    ('state','=', 'done'),
                    ('is_mode_envoi_facture','in', [False,'courrier','courrier2','mail','mail2','mail_client','mail_client_bl']),
                    ('invoice_state','=', '2binvoiced'),
                    ('partner_id.is_societe_comptable','=', 'plasti_ka')
                ]
            </field>
        </record>
    </data>
</odoo>
